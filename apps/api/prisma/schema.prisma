// ============================================================
// TimeFlow — Prisma Schema
// PostgreSQL 16 | Prisma 5
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum TaskStatus {
  planned
  in_progress
  done
}

enum NotificationType {
  task_start
  task_reminder
  task_end
  system
}

enum CriteriaType {
  tasks
  minutes
  both
}

enum TreeStage {
  seed
  sprout
  young
  mature
  ancient
}

enum AmbientSound {
  none
  white_noise
  rain
  lofi
  nature
}

enum AttachmentType {
  link
  image
  pdf
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  name         String  @db.VarChar(100)
  email        String  @unique @db.VarChar(255)
  passwordHash String  @map("password_hash")
  timezone     String  @default("America/Bogota") @db.VarChar(60)
  avatarUrl    String? @map("avatar_url")
  emailVerified Boolean @default(false) @map("email_verified")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  categories        UserCategory[]
  tags              Tag[]
  tasks             Task[]
  timeSessions      TimeSession[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  weekPlans         WeekPlan[]
  dailySummaries    DailySummary[]
  habitSettings     HabitSettings?
  habitDays         HabitDay[]
  streak            Streak?
  audioSettings     AudioSettings?
  timerThresholds   TimerColorThreshold[]

  @@map("users")
}

// ─────────────────────────────────────────────
// CATEGORIES
// ─────────────────────────────────────────────

model SystemCategory {
  id       String  @id @default(cuid())
  name     String  @db.VarChar(60)
  slug     String  @unique @db.VarChar(60)
  icon     String  @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")

  tasks Task[]

  @@map("system_categories")
}

model UserCategory {
  id       String  @id @default(cuid())
  userId   String  @map("user_id")
  name     String  @db.VarChar(60)
  colorHex String  @map("color_hex") @db.VarChar(7)
  icon     String? @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, name])
  @@map("user_categories")
}

// ─────────────────────────────────────────────
// TAGS
// ─────────────────────────────────────────────

model Tag {
  id       String @id @default(cuid())
  userId   String @map("user_id")
  name     String @db.VarChar(40)
  colorHex String @map("color_hex") @db.VarChar(7)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTags TaskTag[]

  @@unique([userId, name])
  @@map("tags")
}

// ─────────────────────────────────────────────
// WEEK PLANS
// ─────────────────────────────────────────────

model WeekPlan {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  weekStart DateTime @map("week_start") @db.Date
  weekEnd   DateTime @map("week_end") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, weekStart])
  @@map("week_plans")
}

// ─────────────────────────────────────────────
// TASKS
// ─────────────────────────────────────────────

model Task {
  id                 String     @id @default(cuid())
  userId             String     @map("user_id")
  weekPlanId         String?    @map("week_plan_id")
  systemCategoryId   String?    @map("system_category_id")
  userCategoryId     String?    @map("user_category_id")
  title              String     @db.VarChar(200)
  description        String?    @db.Text
  colorHex           String     @default("#6366F1") @map("color_hex") @db.VarChar(7)
  status             TaskStatus @default(planned)
  estimatedMinutes   Int?       @map("estimated_minutes")
  position           Int        @default(0)
  scheduledDate      DateTime   @map("scheduled_date") @db.Date
  startTime          DateTime?  @map("start_time") @db.Timestamptz
  endTime            DateTime?  @map("end_time") @db.Timestamptz
  notificationsEnabled  Boolean @default(false) @map("notifications_enabled")
  notifyMinutesBefore   Int     @default(15) @map("notify_minutes_before")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekPlan       WeekPlan?       @relation(fields: [weekPlanId], references: [id], onDelete: SetNull)
  systemCategory SystemCategory? @relation(fields: [systemCategoryId], references: [id], onDelete: SetNull)
  userCategory   UserCategory?   @relation(fields: [userCategoryId], references: [id], onDelete: SetNull)
  timeSessions   TimeSession[]
  notifications  Notification[]
  taskTags       TaskTag[]
  attachments    TaskAttachment[]
  recurrence     TaskRecurrence?

  @@map("tasks")
}

// ─────────────────────────────────────────────
// TASK RECURRENCE
// ─────────────────────────────────────────────

model TaskRecurrence {
  id              String    @id @default(cuid())
  sourceTaskId    String    @unique @map("source_task_id")
  repeatDays      String    @map("repeat_days") @db.VarChar(20) // "0,1,2,3,4" (días de la semana)
  recurrenceStart DateTime  @map("recurrence_start") @db.Date
  recurrenceEnd   DateTime? @map("recurrence_end") @db.Date
  isActive        Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [sourceTaskId], references: [id], onDelete: Cascade)

  @@map("task_recurrences")
}

// ─────────────────────────────────────────────
// TASK TAGS (pivot)
// ─────────────────────────────────────────────

model TaskTag {
  taskId String @map("task_id")
  tagId  String @map("tag_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

// ─────────────────────────────────────────────
// TASK ATTACHMENTS
// ─────────────────────────────────────────────

model TaskAttachment {
  id        String         @id @default(cuid())
  taskId    String         @map("task_id")
  userId    String         @map("user_id")
  type      AttachmentType
  label     String?        @db.VarChar(100)
  url       String         @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_attachments")
}

// ─────────────────────────────────────────────
// TIME SESSIONS
// ─────────────────────────────────────────────

model TimeSession {
  id              String    @id @default(cuid())
  taskId          String    @map("task_id")
  userId          String    @map("user_id")
  startedAt       DateTime  @map("started_at") @db.Timestamptz
  endedAt         DateTime? @map("ended_at") @db.Timestamptz
  durationSeconds Int?      @map("duration_seconds")
  note            String?   @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("time_sessions")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  taskId       String?          @map("task_id")
  type         NotificationType
  title        String           @db.VarChar(200)
  body         String?          @db.Text
  isRead       Boolean          @default(false) @map("is_read")
  isSent       Boolean          @default(false) @map("is_sent")
  scheduledFor DateTime         @map("scheduled_for") @db.Timestamptz
  sentAt       DateTime?        @map("sent_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

// ─────────────────────────────────────────────
// PUSH SUBSCRIPTIONS
// ─────────────────────────────────────────────

model PushSubscription {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  endpoint  String  @unique @db.Text
  p256dhKey String  @map("p256dh_key") @db.Text
  authKey   String  @map("auth_key") @db.Text
  userAgent String? @map("user_agent") @db.VarChar(500)
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

// ─────────────────────────────────────────────
// DAILY SUMMARIES
// ─────────────────────────────────────────────

model DailySummary {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  summaryDate          DateTime @map("summary_date") @db.Date
  tasksPlanned         Int      @default(0) @map("tasks_planned")
  tasksCompleted       Int      @default(0) @map("tasks_completed")
  totalTimeSeconds     Int      @default(0) @map("total_time_seconds")
  estimatedTimeSeconds Int      @default(0) @map("estimated_time_seconds")
  completionRate       Float    @default(0) @map("completion_rate")
  calculatedAt         DateTime @default(now()) @map("calculated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, summaryDate])
  @@map("daily_summaries")
}

// ─────────────────────────────────────────────
// HABIT SETTINGS
// ─────────────────────────────────────────────

model HabitSettings {
  id                String       @id @default(cuid())
  userId            String       @unique @map("user_id")
  minTasksCompleted Int          @default(1) @map("min_tasks_completed")
  minMinutesWorked  Int          @default(30) @map("min_minutes_worked")
  criteriaType      CriteriaType @default(tasks) @map("criteria_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("habit_settings")
}

// ─────────────────────────────────────────────
// HABIT DAYS
// ─────────────────────────────────────────────

model HabitDay {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  day           DateTime @db.Date
  wasSuccessful Boolean  @map("was_successful")
  tasksCompleted Int     @default(0) @map("tasks_completed")
  minutesWorked  Int     @default(0) @map("minutes_worked")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@map("habit_days")
}

// ─────────────────────────────────────────────
// STREAK
// ─────────────────────────────────────────────

model Streak {
  id            String     @id @default(cuid())
  userId        String     @unique @map("user_id")
  currentStreak Int        @default(0) @map("current_streak")
  longestStreak Int        @default(0) @map("longest_streak")
  lastActiveDay DateTime?  @map("last_active_day") @db.Date
  treeStage     TreeStage  @default(seed) @map("tree_stage")
  treeHealth    Int        @default(100) @map("tree_health")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

// ─────────────────────────────────────────────
// AUDIO SETTINGS
// ─────────────────────────────────────────────

model AudioSettings {
  id              String       @id @default(cuid())
  userId          String       @unique @map("user_id")
  ambientSound    AmbientSound @default(none) @map("ambient_sound")
  ambientVolume   Int          @default(50) @map("ambient_volume")
  timerStartSound String       @default("soft_bell") @map("timer_start_sound") @db.VarChar(50)
  timerEndSound   String       @default("chime") @map("timer_end_sound") @db.VarChar(50)
  soundsEnabled   Boolean      @default(true) @map("sounds_enabled")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audio_settings")
}

// ─────────────────────────────────────────────
// TIMER COLOR THRESHOLDS
// ─────────────────────────────────────────────

model TimerColorThreshold {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  threshold Int     // 1-100 (porcentaje)
  colorHex  String  @map("color_hex") @db.VarChar(7)
  pulse     Boolean @default(false)
  sortOrder Int     @default(0) @map("sort_order")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, threshold])
  @@map("timer_color_thresholds")
}
