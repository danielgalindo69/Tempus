# ─── Base de datos ───────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/timeflow?schema=public"

# ─── Redis ───────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT ────────────────────────────────────
JWT_SECRET="cambia_esto_a_un_secreto_muy_largo_y_aleatorio"
JWT_REFRESH_SECRET="cambia_esto_tambien_a_otro_secreto_diferente"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# ─── Web Push (VAPID) ────────────────────────
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@timeflow.app"

# ─── Servidor ─────────────────────────────────
NODE_ENV="development"
PORT=3001
HOST="0.0.0.0"

# ─── CORS ─────────────────────────────────────
CORS_ORIGIN="http://localhost:5173"

# ─── Logs ─────────────────────────────────────
LOG_LEVEL="info"
